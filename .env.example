# Open WLAN Dashboard settings. Copy this file to .env and change what you need; every line is optional,
# a missing or empty value keeps the default shown here. Real environment variables win over .env.
# .env is git-ignored: it may hold a password and MAC addresses.

# --- FRITZ!Box access (dashboard and collector) ---
OWD_FRITZ_HOST=192.168.178.1
OWD_FRITZ_USER=claude
# The password: either directly here, or (default) in the first line of a file only you can read.
OWD_FRITZ_PASSWORD=
OWD_FRITZ_PASSWORD_FILE=~/.claude_fritz

# --- Docker only ---
# Use a release image instead of building one, e.g. ghcr.io/schmidt-software/open-wlan-dashboard:2
# (then: docker compose pull && docker compose up -d).
# OWD_IMAGE=ghcr.io/schmidt-software/open-wlan-dashboard:2
# Time zone of the box log (compose.yaml defaults to Europe/Berlin).
# TZ=Europe/Berlin
# This computer's LAN address, so the box's traffic figures for it are matched (a container sees its own address).
OWD_IP=

# --- Mesh ---
# Display names for mesh routers, by their name in the box (as in the box's WLAN log, e.g. [fritzrepeater]).
# The master is shown as FRITZ!Box, the others with their name from the box unless named here.
# OWD_MESH_NAMES=fritzrepeater1=Upstairs,fritzrepeater2=Cellar
OWD_MESH_NAMES=

# --- Dashboard ---
OWD_DASHBOARD_PORT=8765
# Address the dashboard listens on (default 127.0.0.1, keep it). compose.yaml sets 0.0.0.0 inside the
# container and still publishes the port on 127.0.0.1 of this computer only.
# OWD_DASHBOARD_BIND=127.0.0.1
# Folder for history and alert states (default: next to the scripts; compose.yaml sets /data).
# OWD_DATA_DIR=/path/to/data
# Page refresh in seconds; the box is queried at most this often.
OWD_POLL_S=15

# --- Alert thresholds ---
# Channel load in % (mean of the last 30 min).
OWD_UTIL_WARN=50
OWD_UTIL_CRIT=70
# Noise in dBm; values above mean a noisy channel.
OWD_NOISE_WARN=-85
# Signal of always-on devices in dBm.
OWD_RSSI_WARN=-75
OWD_RSSI_CRIT=-80
# Disconnects per hour of always-on devices (roaming and standby not counted).
OWD_DROPS_WARN=4
OWD_DROPS_CRIT=10
# Mesh router uplink on 5 GHz: signal in dBm, rate in Mbit/s.
OWD_UPLINK_RSSI_WARN=-70
OWD_UPLINK_RATE_WARN=400
# DSL noise margin in dB.
OWD_SNR_WARN=6.0
# Minutes without new history before the collector counts as stopped.
OWD_COLLECTOR_STALE_MIN=40
# Hours a FRITZ!Box restart stays visible.
OWD_REBOOT_ALERT_H=24

# --- Devices and events ---
# A device counts as always-on when connected in this share of at least this many samples of the last 24 h.
OWD_ALWAYS_ON_SHARE=0.9
OWD_ALWAYS_ON_MIN_SAMPLES=8
# MAC addresses never treated as always-on (no offline or weak-signal alerts), comma-separated.
# OWD_NEVER_ALWAYS_ON=AA:BB:CC:DD:EE:FF,AA:BB:CC:DD:EE:00
OWD_NEVER_ALWAYS_ON=
# A logoff with a new login at another radio within this many seconds is roaming.
OWD_ROAM_WINDOW_S=10
# A logoff counts as a disconnect only if the device is back within this many seconds.
OWD_RECONNECT_WINDOW_S=600
# A confirmation or start time is dropped once its problem has been gone this many seconds.
OWD_ACK_FORGET_S=600
